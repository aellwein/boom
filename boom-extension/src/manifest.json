{
  "manifest_version": 3,
  "name": "boom",
  "version": "0.0.1",
  "description": "Sync browser bookmarks through a git repository.",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "boom",
    "default_popup": "popup.html"
  }
}
